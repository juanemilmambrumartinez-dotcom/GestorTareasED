@page "/"
@inject GestorTareasED.Web.Services.ProjectApiService ProjectService

<PageTitle>GestorTareasED</PageTitle>

<div class="hero">
    <span class="hero-eyebrow">GESTOR DE TAREAS PARA EQUIPOS DE DESARROLLO</span>
    <h1 class="hero-title">GestorTareasED</h1>
    <p class="hero-subtitle">
        Organiza los proyectos de tu equipo y da seguimiento a cada tarea,
        desde una sola plataforma, sin depender de herramientas externas.
    </p>
    <a href="/proyectos" class="btn btn-primary btn-lg">Ver mis Proyectos</a>
</div>

<div class="stats-row">
    <div class="stat-card">
        <span class="stat-number">@(totalProyectos?.ToString() ?? "—")</span>
        <span class="stat-label">Proyectos activos</span>
    </div>
    <div class="stat-card">
        <span class="stat-number">@(totalTareas?.ToString() ?? "—")</span>
        <span class="stat-label">Tareas registradas</span>
    </div>
</div>

<div class="feature-grid">
    <div class="feature-card">
        <div class="feature-icon">📁</div>
        <h3>Proyectos</h3>
        <p>Crea y organiza los proyectos de tu equipo, con fechas de inicio y fin claras.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">✅</div>
        <h3>Tareas</h3>
        <p>Da seguimiento a cada tarea con prioridad, estado y fecha límite.</p>
    </div>
    <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Validado</h3>
        <p>Cada dato se valida automáticamente antes de guardarse, sin errores silenciosos.</p>
    </div>
</div>

@code {
    private int? totalProyectos;
    private int? totalTareas;

    protected override async Task OnInitializedAsync()
    {
        var proyectos = await ProjectService.GetAllAsync();
        totalProyectos = proyectos.Count;
    }
}