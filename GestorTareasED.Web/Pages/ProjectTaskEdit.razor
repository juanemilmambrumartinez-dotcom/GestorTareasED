@page "/proyectos/{ProjectId:int}/tareas/{TaskId:int}/editar"
@inject GestorTareasED.Web.Services.TaskApiService TaskService
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

<h1>Editar Tarea</h1>

@if (modelo == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <EditForm Model="@modelo" OnValidSubmit="@Guardar">
        <div class="mb-3">
            <label class="form-label">Título</label>
            <InputText class="form-control" @bind-Value="modelo.Title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputTextArea class="form-control" @bind-Value="modelo.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Prioridad</label>
            <InputSelect class="form-control" @bind-Value="modelo.Priority">
                <option value="Low">Baja</option>
                <option value="Medium">Media</option>
                <option value="High">Alta</option>
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Fecha límite</label>
            <InputDate class="form-control" @bind-Value="modelo.DueDate" />
        </div>

        @if (!string.IsNullOrEmpty(errorMensaje))
        {
            <div class="alert alert-danger">@errorMensaje</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@guardando">
            @(guardando ? "Guardando..." : "Guardar cambios")
        </button>
        <a href="/proyectos/@ProjectId" class="btn btn-secondary">Cancelar</a>
    </EditForm>
}

@code {
    [Parameter]
    public int ProjectId { get; set; }

    [Parameter]
    public int TaskId { get; set; }

    private GestorTareasED.Web.Models.CreateTaskDto? modelo;
    private string? errorMensaje;
    private bool guardando = false;

    protected override async Task OnParametersSetAsync()
    {
        var tarea = await TaskService.GetByIdAsync(TaskId);

        if (tarea != null)
        {
            modelo = new GestorTareasED.Web.Models.CreateTaskDto
            {
                Title = tarea.Title,
                Description = tarea.Description,
                Priority = tarea.Priority,
                DueDate = tarea.DueDate,
                ProjectId = ProjectId
            };
        }
    }

    private async Task Guardar()
    {
        if (modelo == null) return;

        guardando = true;
        errorMensaje = null;

        var response = await TaskService.UpdateAsync(TaskId, modelo);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo($"/proyectos/{ProjectId}");
        }
        else
        {
            errorMensaje = await response.Content.ReadAsStringAsync();
            guardando = false;
        }
    }
}