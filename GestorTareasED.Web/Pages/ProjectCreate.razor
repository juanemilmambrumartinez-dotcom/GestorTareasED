@page "/proyectos/nuevo"
@inject GestorTareasED.Web.Services.ProjectApiService ProjectService
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation

<h1>Nuevo Proyecto</h1>

<EditForm Model="@nuevoProyecto" OnValidSubmit="@Guardar">
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText class="form-control" @bind-Value="nuevoProyecto.Name" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <InputTextArea class="form-control" @bind-Value="nuevoProyecto.Description" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de inicio</label>
        <InputDate class="form-control" @bind-Value="nuevoProyecto.StartDate" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de fin</label>
        <InputDate class="form-control" @bind-Value="nuevoProyecto.EndDate" />
    </div>

    @if (!string.IsNullOrEmpty(errorMensaje))
    {
        <div class="alert alert-danger">@errorMensaje</div>
    }

    <button type="submit" class="btn btn-primary" disabled="@guardando">
        @(guardando ? "Guardando..." : "Guardar")
    </button>
    <a href="/proyectos" class="btn btn-secondary">Cancelar</a>
</EditForm>

@code {
    private GestorTareasED.Web.Models.CreateProjectDto nuevoProyecto = new();
    private string? errorMensaje;
    private bool guardando = false;

    private async Task Guardar()
    {
        guardando = true;
        errorMensaje = null;

        var response = await ProjectService.CreateAsync(nuevoProyecto);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/proyectos");
        }
        else
        {
            errorMensaje = await response.Content.ReadAsStringAsync();
            guardando = false;
        }
    }
}